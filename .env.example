# BetterC0de optional environment settings
# No values are required for a normal local development build.
# Set variables in the shell/process launcher that starts the app.
# Copying this file to .env does not load it into every Electron/Node process.
# Never commit real credentials or signing material.

# Profile root: defaults to ~/.betterc0de-dev in desktop development and
# ~/.betterc0de for the packaged desktop app. Use an absolute path.
# BETTERC0DE_HOME=/absolute/path/to/test-profile

# Override only backend data storage; normally <profile root>/userdata.
# BETTERC0DE_DATA_DIR=/absolute/path/to/backend-data

# Electron provisions this encryption key using its secure storage and hands
# it to the backend over a private IPC channel. Set it only for standalone
# backend operation (node apps/backend/dist/index.js); see the settings
# implementation first. Never publish it or use a shared key across installs.
# BETTERC0DE_SETTINGS_KEY=

# The usage ping and automatic crash reports are off unless turned on in
# Settings > General > Privacy. These force them off even when turned on there
# (CI, managed machines). Manual Send Report remains available.
# BETTERC0DE_DISABLE_PING=1
# BETTERC0DE_DISABLE_CRASH_REPORTS=1

# macOS: skip reading PATH from the login shell at startup.
# BETTERC0DE_SKIP_LOGIN_SHELL_PATH=1

# Experimental: run installed plugins in a separate plugin host process
# instead of the Electron main process, so a plugin that hangs, crashes or
# leaves processes behind does not take the app with it. Off by default.
# BETTERC0DE_PLUGIN_HOST=utility

# Skip the Node-native postinstall rebuild only when your environment already
# provides compatible binaries or explicitly rebuilds them later.
# BETTERC0DE_SKIP_POSTINSTALL=1

# Optional database maintenance interval in milliseconds; 0 disables it.
# BETTERC0DE_VACUUM_INTERVAL_MS=0

# Agent turn limits in milliseconds. A turn times out after this long without
# provider activity (the clock pauses while an approval or question waits for
# you), and in any case after the maximum duration.
# BETTERC0DE_PROVIDER_TURN_TIMEOUT_MS=1800000
# BETTERC0DE_PROVIDER_TURN_MAX_DURATION_MS=43200000
# Idle agent sessions kept running per provider instance (0 keeps none,
# "unlimited" removes the cap).
# BETTERC0DE_PROVIDER_MAX_IDLE_SESSIONS=4

# Backend log verbosity and format (json for machine-readable logs).
# LOG_LEVEL=info
# BETTERC0DE_LOG_FORMAT=json

# Verbose tracing for bug reports: every provider event / every HTTP request.
# BETTERC0DE_TRACE_PROVIDER_EVENTS=1
# BETTERC0DE_TRACE_HTTP=1

# Tool locations when they are not found automatically.
# BETTERC0DE_CLAUDE_CODE_PATH=/absolute/path/to/claude
# BETTERC0DE_GIT_BASH=C:\Program Files\Git\bin\bash.exe

# Login for an external BetterC0de agent server used by the "BetterC0de"
# provider (its server URL is set in the provider's settings). The username
# defaults to "betterc0de". Not related to remote access.
# BETTERC0DE_SERVER_USERNAME=
# BETTERC0DE_SERVER_PASSWORD=

# Remote access (see docs/remote-access.md). Off unless enabled in Settings.
# BETTERC0DE_REMOTE_HOST=0.0.0.0
# BETTERC0DE_ALLOWED_ORIGINS=https://example.com
# BETTERC0DE_TRUST_PROXY=1
# BETTERC0DE_ALLOW_INSECURE_REMOTE_ACCESS=1

# Releases are unsigned by decision (docs/development/code-signing.md). These
# only affect local builds, e.g. npm run build:mac:signed.
# CSC_LINK=
# CSC_KEY_PASSWORD=
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Release tooling (npm run release:check). None of these are needed locally.
# FORMAT_BASE=origin/main   # base revision for the changed-files format check
# HUSKY=0                   # skip the git hooks for one command

# Releases are published by the Release workflow with its own GitHub token;
# local build scripts use --publish never.
