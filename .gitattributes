# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source + config files so Windows checkins never leak CRLF
# into scripts that get executed on macOS/Linux (where a stray \r breaks
# shebangs, regex matches against shell stdout, and JSON parsers in older
# tools).
*.ts text eol=lf
*.tsx text eol=lf
*.cts text eol=lf
*.mts text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.plist text eol=lf
*.gradle text eol=lf

# Git hooks run under sh on every OS, including Git for Windows; a CRLF in a
# hook makes sh read `node\r` as the command name.
.husky/** text eol=lf
.nvmrc text eol=lf
.node-version text eol=lf

# Windows-only launch scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
