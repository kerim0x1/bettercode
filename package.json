{
  "name": "betterc0de",
  "private": true,
  "version": "0.1.0-beta.3",
  "type": "module",
  "main": "apps/shell/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "prepare": "husky",
    "dev": "npm run build:backend && concurrently --kill-others --success first \"npm:dev:vite\" \"npm:schema:dev\" \"npm:backend:dev\" \"node apps/shell/dev.cjs\"",
    "dev:bun": "bun run build:backend && concurrently --kill-others --success first \"bunx vite --config apps/ui/vite.config.ts\" \"npm run backend:dev\" \"bun apps/shell/dev.cjs\"",
    "dev:vite": "vite --config apps/ui/vite.config.ts",
    "mobile:start": "npm run start --workspace @betterc0de/mobile",
    "mobile:android": "npm run android --workspace @betterc0de/mobile",
    "mobile:ios": "npm run ios --workspace @betterc0de/mobile",
    "mobile:web": "npm run web --workspace @betterc0de/mobile",
    "mobile:build:ios": "npm run build:ios:dev --workspace @betterc0de/mobile",
    "mobile:build:ios:preview": "npm run build:ios:preview --workspace @betterc0de/mobile",
    "mobile:check": "node scripts/mobile-checks.mjs",
    "mobile:icons": "node scripts/generate-mobile-icons.mjs",
    "mobile:pages": "node scripts/build-mobile-pages.mjs",
    "mobile:prebuild": "node scripts/mobile-prebuild.mjs",
    "mobile:toolchain": "node scripts/mobile-toolchain.mjs",
    "mobile:apk": "node scripts/mobile-android.mjs",
    "mobile:ios:sim": "node scripts/mobile-ios.mjs",
    "typecheck:mobile": "npm run build:schema && npm run typecheck --workspace @betterc0de/mobile",
    "test:mobile": "npm run test --workspace @betterc0de/mobile",
    "test:e2e:remote": "npm run build:backend && npm run test:e2e --workspace @betterc0de/mobile",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "tsc -b apps/ui --pretty && vite build --config apps/ui/vite.config.ts && node scripts/audit-chunks.cjs && node scripts/audit-bundle-size.cjs",
    "build:schema": "node scripts/prune-build-output.mjs schema && tsc -p packages/schema",
    "build:backend": "npm run build:schema && node scripts/prune-build-output.mjs backend && tsc -p apps/backend/tsconfig.build.json",
    "build:electron": "npm run package",
    "build:mac": "npm run package -- --platform mac",
    "build:mac:signed": "node scripts/build-mac-signed.cjs",
    "build:win": "npm run package -- --platform win",
    "build:linux": "npm run package -- --platform linux",
    "release:check": "node scripts/release-check.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "node scripts/check-format.mjs",
    "format:changed": "node scripts/check-format.mjs --write",
    "typecheck": "tsc --noEmit -p apps/ui/tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p apps/backend",
    "typecheck:shell": "tsc --noEmit -p apps/shell/tsconfig.gate.json",
    "typecheck:shell:checkjs": "tsc --noEmit -p apps/shell/tsconfig.json",
    "typecheck:remotion": "node scripts/typecheck-remotion.mjs",
    "preview": "vite preview --config apps/ui/vite.config.ts",
    "electron:dev": "npm run dev",
    "electron:build": "npm run package",
    "package": "npm run build && node scripts/release-check.mjs --skip-install --from package --until installers --mobile none",
    "package:dir": "npm run build && node scripts/release-check.mjs --skip-install --from package --until smoke --mobile none",
    "package:dir:win": "npm run package:dir -- --platform win",
    "package:dir:mac": "npm run package:dir -- --platform mac",
    "package:dir:linux": "npm run package:dir -- --platform linux",
    "backend:build": "npm run build:backend",
    "backend:dev": "tsc -p apps/backend/tsconfig.build.json --watch",
    "schema:dev": "tsc -p packages/schema --watch --preserveWatchOutput",
    "backend:rebuild": "electron-rebuild -f -w better-sqlite3,node-pty --module-dir apps/backend",
    "test": "vitest run --root apps/ui --config vitest.config.ts",
    "test:backend": "vitest run --root apps/backend --config vitest.config.ts",
    "test:coverage": "vitest run --root apps/ui --config vitest.config.ts --coverage && vitest run --root apps/backend --config vitest.config.ts --coverage",
    "check:versions": "node scripts/check-workspace-versions.mjs",
    "check:contributor-contract": "node scripts/check-contributor-contract.mjs",
    "verify:source": "npm run check:contributor-contract && npm run check:versions && npm run build:backend && npm run typecheck && npm run typecheck:backend && npm run typecheck:shell && npm run typecheck:mobile && npm run typecheck:remotion && npm run format:check && npm run lint && npm run test:packaging && npm test && npm run test:backend && npm run test:mobile && npm run test:e2e:remote",
    "test:packaging": "node --test scripts/*.test.mjs",
    "smoke:backend": "node scripts/backend-startup-smoke.mjs",
    "smoke:remote": "node scripts/remote-access-smoke.mjs",
    "smoke:multichat": "tsc -p scripts/fixtures && node scripts/multichat-model-smoke.mjs",
    "perf:backend": "node scripts/backend-startup-smoke.mjs --startup-budget-ms=6000 --rss-budget-mb=384",
    "smoke:package": "node scripts/packaged-startup-smoke.mjs",
    "smoke:installer": "node scripts/installer-smoke.mjs",
    "icon:generate": "node scripts/generate-icon.cjs",
    "icons:sync": "node scripts/sync-material-icons.mjs",
    "audit:package-size": "node scripts/audit-package-size.cjs",
    "audit:bundle-size": "node scripts/audit-bundle-size.cjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "remotion:dev": "remotion studio remotion/Root.tsx",
    "remotion:render": "remotion render remotion/Root.tsx Walkthrough out/walkthrough.mp4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@anthropic-ai/sdk": "^0.105.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.3",
    "hono": "^4.10.7",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0",
    "openai": "^6.34.0",
    "pino": "^9.5.0",
    "recharts": "^3.10.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/player": "4.0.536",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/color": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "expo": "56.0.16",
    "expo-router": "56.2.15",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "lucide-react": "^1.59.0",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "remotion": "4.0.536",
    "shadcn": "^4.22.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "2.9.1",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "react-native-svg": "15.15.4",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "react-native-gesture-handler": "~2.31.1",
    "test-renderer": "~1.2.0"
  },
  "build": {
    "appId": "com.betterc0de.ide",
    "productName": "BetterC0de",
    "compression": "normal",
    "asar": true,
    "afterPack": "scripts/after-pack-fuses.cjs",
    "afterSign": "apps/shell/build/notarize.cjs",
    "asarUnpack": [
      "apps/shell/default-plugins/**/*",
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kerim0x1",
      "repo": "bettercode"
    },
    "files": [
      "apps/ui/dist/**/*",
      "!apps/ui/dist/sounds/**",
      "!apps/ui/dist/sounds/mechvibes/**",
      "apps/shell/main.cjs",
      "apps/shell/preload.cjs",
      "apps/shell/backend-dev-reloader.cjs",
      "apps/shell/plugin-ipc.cjs",
      "apps/shell/plugin-manager.cjs",
      "apps/shell/onboarding-ipc.cjs",
      "apps/shell/mcp-ipc.cjs",
      "apps/shell/skills-ipc.cjs",
      "apps/shell/hooks-ipc.cjs",
      "apps/shell/subagents-ipc.cjs",
      "apps/shell/cli-scanner.cjs",
      "apps/shell/cli-plugins-ipc.cjs",
      "apps/shell/cli-plugins.cjs",
      "apps/shell/provider-ipc.cjs",
      "apps/shell/skills-sh.cjs",
      "apps/shell/browser-preview-preload.cjs",
      "apps/shell/html-preview.cjs",
      "apps/shell/preview-request-capture.cjs",
      "apps/shell/shared/**/*.cjs",
      "apps/shell/default-plugins/**/*",
      "apps/backend/dist/**/*",
      "!apps/backend/dist/**/*.test.*",
      "!apps/backend/dist/**/*.spec.*",
      "apps/backend/package.json",
      "apps/backend/node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      {
        "from": "packages/schema",
        "to": "node_modules/@betterc0de/schema",
        "filter": [
          "package.json",
          "dist/**/*",
          "!dist/**/*.map"
        ]
      },
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "LICENSE"
    ],
    "win": {
      "icon": "apps/shell/build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "apps/shell/build/entitlements.mac.plist",
      "entitlementsInherit": "apps/shell/build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "BetterC0de does not access the camera.",
        "NSMicrophoneUsageDescription": "BetterC0de uses the microphone only if you explicitly enable voice input."
      },
      "extraResources": [],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**"
      ]
    },
    "dmg": {
      "sign": true
    },
    "linux": {
      "maintainer": "BetterC0de contributors <info@wibify.de>",
      "icon": "apps/shell/build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Development",
      "synopsis": "AI-powered coding IDE",
      "description": "BetterC0de is an AI-powered IDE with a Node.js backend and provider-agnostic chat.",
      "extraResources": [],
      "extraFiles": [
        {
          "from": "apps/shell/build/com.betterc0de.ide.metainfo.xml",
          "to": "usr/share/metainfo/com.betterc0de.ide.metainfo.xml"
        }
      ],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-darwin/**",
        "!**/node_modules/@anthropic-ai/claude-agent-sdk-linux-*-musl{,/**/*}"
      ]
    },
    "rpm": {
      "fpm": [
        "--directories",
        "/opt/BetterC0de"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "apps/shell/build/icon.ico",
      "uninstallerIcon": "apps/shell/build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "description": "A desktop AI coding environment for agents, files, terminals, and live previews.",
  "homepage": "https://betterc0de.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kerim0x1/bettercode.git"
  },
  "bugs": {
    "url": "https://github.com/kerim0x1/bettercode/issues"
  },
  "author": "BetterC0de contributors",
  "engines": {
    "node": "^22.15.0 || ^24.0.0",
    "npm": ">=10"
  },
  "license": "MIT"
}
