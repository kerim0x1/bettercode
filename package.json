{
  "name": "betterc0de",
  "private": true,
  "version": "0.1.0-beta.2",
  "type": "module",
  "main": "apps/shell/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "npm run build:backend && concurrently --kill-others --success first \"npm:dev:vite\" \"npm:backend:dev\" \"node apps/shell/dev.cjs\"",
    "dev:bun": "bun run build:backend && concurrently --kill-others --success first \"bunx vite --config apps/ui/vite.config.ts\" \"npm run backend:dev\" \"bun apps/shell/dev.cjs\"",
    "dev:vite": "vite --config apps/ui/vite.config.ts",
    "mobile:start": "npm run start --workspace @betterc0de/mobile",
    "mobile:android": "npm run android --workspace @betterc0de/mobile",
    "mobile:ios": "npm run ios --workspace @betterc0de/mobile",
    "mobile:web": "npm run web --workspace @betterc0de/mobile",
    "mobile:build:ios": "npm run build:ios:dev --workspace @betterc0de/mobile",
    "mobile:build:ios:preview": "npm run build:ios:preview --workspace @betterc0de/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @betterc0de/mobile",
    "test:mobile": "npm run test --workspace @betterc0de/mobile",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "tsc -b apps/ui --pretty && vite build --config apps/ui/vite.config.ts && node scripts/audit-chunks.cjs && node scripts/audit-bundle-size.cjs",
    "build:schema": "node scripts/prune-build-output.mjs schema && tsc -p packages/schema",
    "build:backend": "npm run build:schema && node scripts/prune-build-output.mjs backend && tsc -p apps/backend",
    "build:electron": "npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --win --publish never && npm run audit:package-size",
    "build:mac": "npm run build:schema && npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --mac --publish never",
    "build:mac:signed": "node scripts/require-mac.cjs && bash -c 'set -a && source .env.signing && set +a && npm run build:mac'",
    "build:win": "npm run build:schema && npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --win --publish never",
    "build:linux": "npm run build:schema && npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --linux --publish never",
    "release:check": "electron-builder --publish never",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p apps/ui/tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p apps/backend",
    "typecheck:remotion": "node scripts/typecheck-remotion.mjs",
    "preview": "vite preview --config apps/ui/vite.config.ts",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build:electron",
    "package": "npm run build:electron",
    "package:dir:win": "npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --win --dir --publish never && npm run audit:package-size",
    "package:dir:mac": "npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --mac --dir --publish never && npm run audit:package-size",
    "package:dir:linux": "npm run build:backend && npm run build:frontend && npm run clean:release && node scripts/strip-packaging-artifacts.cjs && node scripts/pack-electron.cjs --linux --dir --publish never && npm run audit:package-size",
    "backend:build": "npm run build:backend",
    "backend:dev": "tsc -p apps/backend --watch",
    "backend:rebuild": "electron-rebuild -f -w better-sqlite3,node-pty --module-dir apps/backend",
    "test": "vitest run --root apps/ui --config vitest.config.ts",
    "test:backend": "vitest run --root apps/backend --config vitest.config.ts",
    "check:versions": "node scripts/check-workspace-versions.mjs",
    "verify:source": "npm run check:versions && npm run build:backend && npm run typecheck && npm run typecheck:backend && npm run typecheck:mobile && npm run typecheck:remotion && npm run lint && npm run test:packaging && npm test && npm run test:backend && npm run test:mobile",
    "test:packaging": "node --test scripts/*.test.mjs",
    "smoke:backend": "node scripts/backend-startup-smoke.mjs",
    "smoke:remote": "node scripts/remote-access-smoke.mjs",
    "smoke:multichat": "tsc -p scripts/fixtures && node scripts/multichat-model-smoke.mjs",
    "perf:backend": "node scripts/backend-startup-smoke.mjs --startup-budget-ms=6000 --rss-budget-mb=384",
    "smoke:package": "node scripts/packaged-startup-smoke.mjs",
    "icon:generate": "node scripts/generate-icon.cjs",
    "icons:sync": "node scripts/sync-material-icons.mjs",
    "audit:package-size": "node scripts/audit-package-size.cjs",
    "audit:bundle-size": "node scripts/audit-bundle-size.cjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "remotion:dev": "remotion studio remotion/Root.tsx",
    "remotion:render": "remotion render remotion/Root.tsx Walkthrough out/walkthrough.mp4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.123",
    "@anthropic-ai/sdk": "^0.105.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "@types/dompurify": "^3.0.5",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.3",
    "fast-glob": "^3.3.3",
    "hono": "^4.10.7",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0",
    "openai": "^6.34.0",
    "pino": "^9.5.0",
    "tar": "^7.5.13",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@remotion/cli": "4.0.496",
    "@remotion/media-utils": "4.0.496",
    "@remotion/player": "4.0.496",
    "@shikijs/transformers": "^4.0.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/color": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.146",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "expo": "56.0.16",
    "expo-router": "56.2.15",
    "fuse.js": "^7.3.0",
    "globals": "^16.5.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "material-icon-theme": "5.38.1",
    "monaco-editor": "^0.53.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "postcss": "^8.5.9",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "remotion": "4.0.496",
    "shadcn": "^4.1.2",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tippy.js": "^6.3.7",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "use-stick-to-bottom": "^1.1.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "react-native-svg": "15.15.4",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  },
  "build": {
    "appId": "com.betterc0de.ide",
    "productName": "BetterC0de",
    "compression": "normal",
    "asar": true,
    "afterSign": "apps/shell/build/notarize.cjs",
    "asarUnpack": [
      "apps/shell/default-plugins/**/*",
      "**/*.node",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kerim0x1",
      "repo": "bettercode"
    },
    "files": [
      "apps/ui/dist/**/*",
      "!apps/ui/dist/sounds/**",
      "!apps/ui/dist/sounds/mechvibes/**",
      "apps/shell/main.cjs",
      "apps/shell/preload.cjs",
      "apps/shell/backend-dev-reloader.cjs",
      "apps/shell/plugin-ipc.cjs",
      "apps/shell/plugin-manager.cjs",
      "apps/shell/onboarding-ipc.cjs",
      "apps/shell/mcp-ipc.cjs",
      "apps/shell/skills-ipc.cjs",
      "apps/shell/hooks-ipc.cjs",
      "apps/shell/subagents-ipc.cjs",
      "apps/shell/cli-scanner.cjs",
      "apps/shell/cli-plugins-ipc.cjs",
      "apps/shell/cli-plugins.cjs",
      "apps/shell/provider-ipc.cjs",
      "apps/shell/skills-sh.cjs",
      "apps/shell/oauth/**/*.cjs",
      "apps/shell/browser-preview-preload.cjs",
      "apps/shell/html-preview.cjs",
      "apps/shell/preview-request-capture.cjs",
      "apps/shell/shared/**/*.cjs",
      "apps/shell/default-plugins/**/*",
      "apps/backend/dist/**/*",
      "!apps/backend/dist/**/*.test.*",
      "!apps/backend/dist/**/*.spec.*",
      "apps/backend/package.json",
      "apps/backend/node_modules/**/*",
      "node_modules/@anthropic-ai/sdk/**/*",
      "node_modules/@modelcontextprotocol/sdk/**/*",
      "node_modules/zod/**/*",
      "node_modules/tar/**/*",
      "node_modules/minizlib/**/*",
      "node_modules/minipass/**/*",
      "node_modules/yallist/**/*",
      "node_modules/chownr/**/*",
      "node_modules/mkdirp/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/ignore/**/*",
      "node_modules/ws/**/*",
      "node_modules/pino/**/*",
      "node_modules/atomic-sleep/**/*",
      "node_modules/on-exit-leak-free/**/*",
      "node_modules/pino-abstract-transport/**/*",
      "node_modules/pino-std-serializers/**/*",
      "node_modules/process-warning/**/*",
      "node_modules/quick-format-unescaped/**/*",
      "node_modules/real-require/**/*",
      "node_modules/safe-stable-stringify/**/*",
      "node_modules/@pinojs/redact/**/*",
      "node_modules/sonic-boom/**/*",
      "node_modules/thread-stream/**/*",
      "node_modules/split2/**/*",
      "node_modules/cross-spawn/**/*",
      "node_modules/path-key/**/*",
      "node_modules/shebang-command/**/*",
      "node_modules/shebang-regex/**/*",
      "node_modules/which/**/*",
      "node_modules/isexe/**/*",
      "!**/*.map",
      "!**/*.md",
      {
        "from": "packages/schema",
        "to": "node_modules/@betterc0de/schema",
        "filter": [
          "package.json",
          "dist/**/*",
          "!dist/**/*.map"
        ]
      },
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "LICENSE"
    ],
    "win": {
      "icon": "apps/shell/build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "apps/shell/build/entitlements.mac.plist",
      "entitlementsInherit": "apps/shell/build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "BetterC0de does not access the camera.",
        "NSMicrophoneUsageDescription": "BetterC0de uses the microphone only if you explicitly enable voice input."
      },
      "extraResources": [],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-linux/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**"
      ]
    },
    "dmg": {
      "sign": true
    },
    "linux": {
      "maintainer": "BetterC0de contributors <info@wibify.de>",
      "icon": "apps/shell/build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Development",
      "synopsis": "AI-powered coding IDE",
      "description": "BetterC0de is an AI-powered IDE with a Node.js backend and provider-agnostic chat.",
      "extraResources": [],
      "files": [
        "package.json",
        "!Example{,/**/*}",
        "!Another_Example{,/**/*}",
        "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-win32/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-darwin/**",
        "!**/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-darwin/**",
        "!**/node_modules/@anthropic-ai/claude-agent-sdk-linux-*-musl{,/**/*}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "apps/shell/build/icon.ico",
      "uninstallerIcon": "apps/shell/build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "description": "A desktop AI coding environment for agents, files, terminals, and live previews.",
  "homepage": "https://betterc0de.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kerim0x1/bettercode.git"
  },
  "bugs": {
    "url": "https://github.com/kerim0x1/bettercode/issues"
  },
  "author": "BetterC0de contributors",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10"
  },
  "license": "MIT"
}
