// The end-to-end tests run in Node against the desktop backend, through the
// app's network client (src/transport/live), which has no React Native code.
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["e2e/**/*.ts"]
}
