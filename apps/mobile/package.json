{
  "name": "@betterc0de/mobile",
  "version": "0.1.0-beta.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "eas-build-post-install": "npm run build --workspace @betterc0de/schema"
  },
  "dependencies": {
    "@betterc0de/schema": "*",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~56.0.15",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~56.0.17",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
