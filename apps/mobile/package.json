{
  "name": "@betterc0de/mobile",
  "version": "0.1.0-beta.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "node ../../scripts/mobile-prebuild.mjs",
    "android": "node ../../scripts/mobile-prebuild.mjs android && expo run:android",
    "ios": "node ../../scripts/mobile-prebuild.mjs ios && expo run:ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:components": "jest --config jest.config.cjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "eas-build-post-install": "npm run build --workspace @betterc0de/schema"
  },
  "dependencies": {
    "@betterc0de/schema": "*",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~56.0.17",
    "expo": "~56.0.16",
    "expo-build-properties": "~56.0.23",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "~56.0.17",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
