<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime exceptions only; this app does not use the App
         Sandbox, so sandbox keys (network.client, files.user-selected.*,
         inherit) would have no effect and are deliberately absent.
         Do not widen this plist unless a signed packaged build proves the
         exception is needed. -->

    <!-- Required by hardened runtime for Electron + V8 JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native Node modules (better-sqlite3, node-pty) load from
         app.asar.unpacked into the app and the forked backend.
         electron-builder's own default entitlements keep library validation
         off for native modules (electron-userland/electron-builder#3940);
         drop this only after a signed build shows they still load. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- No com.apple.security.cs.allow-dyld-environment-variables: with it,
         DYLD_INSERT_LIBRARIES could inject code into the signed app and
         inherit its privacy (TCC) grants such as the microphone. -->
</dict>
</plist>
