    "@modelcontextprotocol/sdk": "~1.32.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "ignore": "^7.0.12",
    "node-pty": "^1.1.0",
    "openai": "^7.38.0",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
