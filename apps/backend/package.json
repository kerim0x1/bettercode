{
  "name": "@betterc0de/backend",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "commonjs",
  "description": "BetterC0de Node.js backend (Hono HTTP + ws + better-sqlite3).",
  "main": "dist/inProcess.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
